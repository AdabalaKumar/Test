# Copy to .env.local and adjust. Every value is optional for local development.

# Public origin of the site, used for canonical and Open Graph URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Signs session cookies. Set a random value of 32+ characters in production
# (e.g. `openssl rand -hex 48`). If unset, a secret is generated and stored in the database.
AUTH_SECRET=

# Credentials for the administrator created the first time the database is seeded.
ADMIN_EMAIL=admin@aurelia.example
ADMIN_PASSWORD=

# Where the SQLite database and uploaded files live. Point this at a persistent volume in production.
DATA_DIR=./data

# Optional: Google Maps Embed API key. Without it the keyless embed is used.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
